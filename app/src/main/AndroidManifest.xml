<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gravar áudio junto com a escrita (só quando a pessoa toca em "Gravar áudio") -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Conferir se há versão nova do app no GitHub ao abrir -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".FoldersActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Notas compartilhadas pelo Samsung Notes (.sdocx) -->
            <intent-filter android:label="Importar no RosaNotes">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/sdocx" />
                <data android:mimeType="application/x-sdocx" />
                <data android:mimeType="application/vnd.samsung.sdocx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <intent-filter android:label="Importar no RosaNotes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/sdocx" />
                <data android:mimeType="application/x-sdocx" />
                <data android:mimeType="application/vnd.samsung.sdocx" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
